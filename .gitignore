# Build output and dependencies. GitHub Pages builds from source, so dist/ never
# needs committing.
node_modules
dist
tmp

# Python bytecode from tools/
__pycache__/
*.pyc

# Claude Code: launch.json is shared, local permissions are not.
.claude/settings.local.json

# OS and Dropbox litter. This project lives inside a Dropbox folder, which sprays
# these around.
.DS_Store
Thumbs.db
desktop.ini
Icon?
.dropbox
.dropbox.attr
*~

# Authoring files for the 3D work. The source of truth for the seabed is
# TectonicSeabed.blend, which lives outside this repo in Digital Culture/Models -- it
# is 68 MB and it is not what the app loads. `tools/convert_seabed.py` turns it into
# src/assets/Models/TectonicSeabed.glb, ~1 MB, and that GLB *is* committed because the
# Pages build needs it. Keeping the intermediate FBX out saves 19 MB of a file that
# webpack already refuses to deploy.
src/assets/**/*.fbx
src/assets/**/*.blend
src/assets/**/*.blend1
